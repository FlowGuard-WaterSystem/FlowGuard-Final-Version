<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0c2330" />
  <title>FlowGuard Admin</title>
  <style>
    :root {
      color-scheme: light;
      --ink: #18323d;
      --muted: #71858b;
      --line: #e5edef;
      --paper: #ffffff;
      --canvas: #f2f7f6;
      --teal: #087f78;
      --teal-dark: #076b66;
      --mint: #d9f4ed;
      --nav: #0c2330;
      --danger: #bd3c4a;
      --shadow: 0 12px 35px rgba(20, 58, 65, .07);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      color: var(--ink);
      background: radial-gradient(ellipse at 80% 0%, #dcefeb 0, transparent 38%), var(--canvas);
      font-family: Inter, "Segoe UI", Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    .topbar {
      position: sticky;
      top: 0;
      z-index: 5;
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding: 12px clamp(18px, 5vw, 64px);
      color: #fff;
      background: rgba(12, 35, 48, .97);
      box-shadow: 0 8px 25px rgba(8, 36, 44, .14);
      backdrop-filter: blur(14px);
    }
    .brand {
      display: inline-flex;
      align-items: center;
      gap: 11px;
      color: #fff;
      text-decoration: none;
      font-size: 19px;
      font-weight: 800;
      letter-spacing: -.4px;
      white-space: nowrap;
    }
    .brand-mark {
      width: 36px;
      height: 36px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      color: #073d3b;
      background: linear-gradient(145deg, #a1efdb, #31c2aa);
      font-size: 17px;
      box-shadow: 0 5px 18px rgba(49, 194, 170, .22);
    }
    .brand small { display: block; margin-top: 2px; color: #a9c1c5; font-size: 10px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; }
    .navlinks { display: flex; align-items: center; gap: 5px; flex-wrap: wrap; }
    .navlinks a {
      position: relative;
      padding: 10px 13px;
      border-radius: 10px;
      color: #c4d4d7;
      text-decoration: none;
      font-size: 13px;
      font-weight: 650;
      transition: color .2s ease, background .2s ease, transform .2s ease;
    }
    .navlinks a:hover { color: #fff; background: rgba(255,255,255,.09); transform: translateY(-1px); }
    .navlinks a.active { color: #b1f2df; background: rgba(71, 193, 165, .15); }
    main { width: min(1180px, 100%); margin: 0 auto; padding: 38px clamp(18px, 5vw, 64px) 64px; animation: page-in .48s cubic-bezier(.2,.75,.25,1) both; }
    h1, h2, h3, p { margin-top: 0; }
    h1, h2 { margin-bottom: 8px; font-size: clamp(25px, 3vw, 34px); line-height: 1.15; letter-spacing: -1px; }
    h3 { margin-bottom: 14px; font-size: 17px; letter-spacing: -.25px; }
    .page-heading { display: flex; align-items: end; justify-content: space-between; gap: 18px; margin: 0 0 26px; }
    .eyebrow { margin: 0 0 8px; color: var(--teal); font-size: 11px; font-weight: 800; letter-spacing: 1.6px; text-transform: uppercase; }
    .page-subtitle { margin: 0; color: var(--muted); font-size: 14px; }
    .date-chip { padding: 9px 13px; border: 1px solid #dce8e7; border-radius: 999px; color: #557077; background: rgba(255,255,255,.72); font-size: 12px; font-weight: 650; white-space: nowrap; }
    .cards { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 15px; margin: 24px 0; }
    .card { min-width: 0; margin-bottom: 17px; padding: 21px; border: 1px solid rgba(222, 234, 234, .9); border-radius: 17px; background: var(--paper); box-shadow: var(--shadow); }
    .metric-card { position: relative; overflow: hidden; min-height: 152px; padding: 19px; animation: rise-in .55s cubic-bezier(.2,.75,.25,1) both; transition: transform .22s ease, box-shadow .22s ease; }
    .metric-card:nth-child(2) { animation-delay: .06s; }
    .metric-card:nth-child(3) { animation-delay: .12s; }
    .metric-card:nth-child(4) { animation-delay: .18s; }
    .metric-card:nth-child(5) { animation-delay: .24s; }
    .metric-card:hover { transform: translateY(-4px); box-shadow: 0 18px 38px rgba(20,58,65,.12); }
    .metric-card::after { position: absolute; right: -24px; bottom: -39px; width: 118px; height: 118px; border-radius: 50%; background: var(--metric-wash, #e4f5f0); content: ""; transition: transform .35s ease; }
    .metric-card:hover::after { transform: scale(1.18); }
    .metric-top { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center; }
    .metric-icon { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 11px; color: var(--metric-color, var(--teal)); background: var(--metric-wash, #e4f5f0); font-size: 12px; font-weight: 850; }
    .metric-value { position: relative; z-index: 1; display: block; margin: 17px 0 4px; color: var(--ink); font-size: 34px; font-weight: 800; line-height: 1; letter-spacing: -1.5px; }
    .metric-label { position: relative; z-index: 1; color: var(--muted); font-size: 12px; font-weight: 650; }
    .tone-alert { --metric-color: #b7573b; --metric-wash: #fff0e6; }
    .tone-issues { --metric-color: #5273ad; --metric-wash: #edf2ff; }
    .tone-pending { --metric-color: #ad7c1c; --metric-wash: #fff5d9; }
    .tone-progress { --metric-color: #397da0; --metric-wash: #e6f5fb; }
    .tone-resolved { --metric-color: #16816d; --metric-wash: #e0f6ed; }
    .section-card { padding: 0; overflow: hidden; }
    .section-heading { display: flex; align-items: center; justify-content: space-between; gap: 15px; padding: 21px 23px; border-bottom: 1px solid var(--line); }
    .section-heading h3 { margin: 0; }
    .section-heading small { color: var(--muted); }
    .table-scroll { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; background: var(--paper); }
    th, td { padding: 14px 19px; border-bottom: 1px solid #edf2f2; text-align: left; vertical-align: middle; }
    th { color: #73888d; background: #fbfdfd; font-size: 10px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; }
    td { color: #36515a; font-size: 13px; }
    tr:last-child td { border-bottom: 0; }
    tbody tr { transition: background .18s ease; }
    tbody tr:hover { background: #f6fbfa; }
    .empty-state { padding: 30px 20px; color: var(--muted); text-align: center; }
    input, select, textarea { max-width: 100%; padding: 11px 13px; border: 1px solid #d7e3e4; border-radius: 10px; outline: none; color: var(--ink); background: #fff; font: inherit; transition: border .18s ease, box-shadow .18s ease; }
    input:focus, select:focus, textarea:focus { border-color: #48aa9a; box-shadow: 0 0 0 3px rgba(72,170,154,.15); }
    textarea { display: block; width: min(100%, 680px); box-sizing: border-box; }
    form.card { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    form.card h3 { flex-basis: 100%; margin-bottom: 4px; }
    .inline-edit { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
    .inline-delete { display: inline-block; margin-top: 6px; }
    .post-head { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    .post-head small { margin-left: auto; color: var(--muted); }
    .post-text { white-space: pre-wrap; }
    .comments { border-left: 3px solid var(--line); margin: 12px 0; padding-left: 12px; }
    .comment { padding: 8px 0; }
    .comment p { white-space: pre-wrap; margin: 4px 0; }
    .comment small { color: var(--muted); }
    .actions { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .reply-form { flex: 1; min-width: 240px; }
    button.btn { padding: 10px 15px; border: 0; border-radius: 10px; color: #fff; background: var(--teal); cursor: pointer; font: inherit; font-size: 13px; font-weight: 750; box-shadow: 0 5px 12px rgba(8,127,120,.14); transition: transform .18s ease, background .18s ease, box-shadow .18s ease; }
    button.btn:hover { transform: translateY(-2px); background: var(--teal-dark); box-shadow: 0 8px 18px rgba(8,127,120,.22); }
    button.danger { background: var(--danger); box-shadow: 0 5px 12px rgba(189,60,74,.12); }
    button.danger:hover { background: #a52f3d; }
    .tag { display: inline-flex; align-items: center; padding: 5px 9px; border: 1px solid #e3ebeb; border-radius: 999px; color: #526c71; background: #f5f8f8; font-size: 11px; font-weight: 700; }
    .err { color: var(--danger); }
    img { border-radius: 9px; object-fit: cover; }
    @@keyframes page-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes rise-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
    @@media (max-width: 900px) {
      .topbar { align-items: flex-start; flex-direction: column; gap: 10px; padding: 14px 20px; }
      .navlinks { width: 100%; }
      .navlinks a { padding: 9px 10px; }
      .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @@media (max-width: 540px) {
      main { padding-top: 26px; }
      .page-heading { align-items: flex-start; flex-direction: column; }
      .cards { gap: 10px; }
      .metric-card { min-height: 135px; padding: 15px; }
      th, td { padding: 11px 13px; }
    }
    @@media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">F</span>
      <span>FlowGuard<small>Municipal operations</small></span>
    </a>
    <nav class="navlinks" aria-label="Main navigation">
      <a class="@(Context.Request.Path == "/" ? "active" : "")" href="/">Dashboard</a>
      <a class="@(Context.Request.Path.StartsWithSegments("/Alerts") ? "active" : "")" href="/Alerts">Alerts</a>
      <a class="@(Context.Request.Path.StartsWithSegments("/Issues") ? "active" : "")" href="/Issues">Issues</a>
      <a class="@(Context.Request.Path.StartsWithSegments("/Community") ? "active" : "")" href="/Community">Community</a>
      <a class="@(Context.Request.Path.StartsWithSegments("/Supply") ? "active" : "")" href="/Supply">Supply</a>
      <a class="@(Context.Request.Path.StartsWithSegments("/Infrastructure") ? "active" : "")" href="/Infrastructure">Infrastructure</a>
    </nav>
  </header>
  <main>@RenderBody()</main>
</body>
</html>
